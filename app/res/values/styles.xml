<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The light background already in the window: opening the home screen never flashes another color. -->
    <color name="home_background">#EBEBF0</color>

    <style name="WatchMatch.Home" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/home_background</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>

    <!-- Watchme+ and its player: black from the first frame. -->
    <color name="cinema_background">#0B0B0D</color>
    <style name="WatchMatch.Cinema" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/cinema_background</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
</resources>
